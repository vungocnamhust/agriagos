{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/claude/env_guard.py",
        "timeout": 5
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/claude/session_start.py",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/claude/session_start.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 scripts/claude/contract_drift.py",
        "timeout": 10
      }
    ]
  }
}